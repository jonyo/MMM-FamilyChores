{
  "name": "mmm-familychores",
  "version": "1.0.0",
  "description": "A TypeScript-based MagicMirror² module for family chore tracking with personal daily chores, rotating daily chores that cycle through family members, and a summary view.",
  "main": "MMM-FamilyChores.js",
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:node && pnpm run build:admin && pnpm run copy:dist",
    "build:client": "vite build --config vite.client.config.ts",
    "build:node": "vite build --config vite.node.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "copy:dist": "cp -r dist/client/* . && cp -r dist/node/* . && cp dist/admin/* public/",
    "typecheck": "tsc --noEmit",
    "lint": "biome check && eslint",
    "fix": "biome check --write --unsafe && eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "prepare": "husky install",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "playwright:install": "playwright install"
  },
  "keywords": [
    "magicmirror",
    "module",
    "family",
    "chores",
    "typescript"
  ],
  "author": "Jonathan Foote",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/magicmirror-module": "^2.16.6",
    "@types/node": "^20.x",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/browser-playwright": "^4.1.6",
    "eslint": "^10.3.0",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-solid": "^0.14.5",
    "husky": "^9.1.7",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.3.0",
    "terser": "^5.47.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
